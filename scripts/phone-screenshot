#!/bin/bash
# Take a screenshot from Android phone, save to Mac Pictures
TIMESTAMP=$(date +%Y%m%d_%H%M%S)
FILENAME=~/Pictures/phone_screenshot_${TIMESTAMP}.png
adb shell screencap -p /sdcard/phone_screenshot.png && \
adb pull /sdcard/phone_screenshot.png "$FILENAME" && \
adb shell rm /sdcard/phone_screenshot.png && \
echo "✅ Screenshot saved: $FILENAME"